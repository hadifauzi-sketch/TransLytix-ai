# Configure in Vercel project environment variables. Never use a VITE_ prefix.
AI_API_TOKEN=replace-with-a-long-random-secret
# Optional: browser origins only if you deliberately call Python cross-origin.
AI_ALLOWED_ORIGINS=http://localhost:3000
# Local standalone main.py only; set BEFORE first start to create the admin.
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-local-start
