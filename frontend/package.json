{
  "name": "transformer-dga-ml",
  "private": true,
  "version": "1.1.0",
  "description": "Transformer Asset Management + ML Analytics (DGA)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/sync-plotly-vendor.cjs",
    "prebuild": "node ./scripts/sync-plotly-vendor.cjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm:dev\" \"npm:electron:start\"",
    "electron:start": "wait-on http://localhost:3000 && cross-env ELECTRON_DEV=1 VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .",
    "electron:build:backend": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-backend.ps1",
    "electron:dist": "npm run build && electron-builder --win nsis",
    "electron:dist:portable": "npm run build && electron-builder --win portable",
    "electron:dist:full": "npm run electron:build:backend && npm run electron:dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/pdfkit": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.4",
    "plotly.js": "^3.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.hadif.transformerassetml",
    "productName": "Transformer Asset ML",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../main.py",
        "to": "backend/main.py"
      },
      {
        "from": "../requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "../ai_engine",
        "to": "backend/ai_engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "public/deep-learning.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
